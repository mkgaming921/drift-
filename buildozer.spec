[app]
title = DRIFT Mobile
package.name = driftmobile
package.domain = com.mustafa.games
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,pygame
orientation = landscape
fullscreen = 1
android.permissions = VIBRATE
android.api = 35
android.minapi = 23
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
